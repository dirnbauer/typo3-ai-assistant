{
    "name": "webconsulting/typo3-ai-assistant",
    "description": "Native AI assistant for the TYPO3 v14 backend: chat with your installation through in-process MCP tools, with human approval for every write",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "extension",
        "backend",
        "AI",
        "assistant",
        "chat",
        "MCP",
        "LLM"
    ],
    "authors": [
        {
            "name": "Webconsulting",
            "homepage": "https://github.com/dirnbauer",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-ai-assistant",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-ai-assistant/issues",
        "source": "https://github.com/dirnbauer/typo3-ai-assistant"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-mcp-server.git",
            "only": [
                "hn/typo3-mcp-server"
            ]
        },
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-abilities.git",
            "only": [
                "webconsulting/typo3-abilities"
            ]
        }
    ],
    "require": {
        "php": "^8.4",
        "hn/typo3-mcp-server": "^0.8",
        "netresearch/nr-llm": "^0.35",
        "phpoffice/phpword": "^1.4",
        "smalot/pdfparser": "^2.12",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "saschaegerer/phpstan-typo3": "^3.1",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.7"
    },
    "suggest": {
        "phpoffice/phpspreadsheet": "Lets editors attach XLSX spreadsheets to a chat message"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\WebconAiAssistant\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\WebconAiAssistant\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "platform": {
            "php": "8.4.1"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "webcon_ai_assistant",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "ci": [
            "@ci:lint",
            "@ci:phpstan",
            "@ci:cgl",
            "@ci:tests"
        ],
        "ci:lint": "find Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null",
        "ci:phpstan": ".Build/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
        "ci:cgl": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "ci:tests": [
            "@ci:tests:unit",
            "@ci:tests:functional"
        ],
        "ci:tests:unit": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "ci:tests:functional": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "fix:cgl": ".Build/bin/php-cs-fixer fix"
    }
}
