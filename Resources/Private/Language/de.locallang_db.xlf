  <file source-language="en" target-language="de" datatype="plaintext" original="EXT:webcon_ai_assistant/Resources/Private/Language/locallang_db.xlf" date="2026-09-23T00:00:00Z" product-name="webcon_ai_assistant">
    <header/>
    <body>
      <trans-unit id="tx_webconaiassistant_instruction" resname="tx_webconaiassistant_instruction">
        <source>AI Assistant instruction</source>
        <target>KI-Assistent-Anweisung</target>
      </trans-unit>
      <trans-unit id="tx_webconaiassistant_instruction.be_groups" resname="tx_webconaiassistant_instruction.be_groups">
        <source>Applies to backend groups</source>
        <target>Gilt für Backend-Gruppen</target>
      </trans-unit>
      <trans-unit id="tx_webconaiassistant_instruction.be_groups.description" resname="tx_webconaiassistant_instruction.be_groups.description">
        <source>Leave empty to apply to every user. Otherwise only members of the selected groups receive this instruction.</source>
        <target>Leer lassen, damit sie für alle Benutzer gilt. Sonst erhalten nur Mitglieder der gewählten Gruppen diese Anweisung.</target>
      </trans-unit>
      <trans-unit id="tx_webconaiassistant_instruction.body" resname="tx_webconaiassistant_instruction.body">
        <source>Instruction</source>
        <target>Anweisung</target>
      </trans-unit>
      <trans-unit id="tx_webconaiassistant_instruction.body.description" resname="tx_webconaiassistant_instruction.body.description">
        <source>Written into the system prompt of every conversation it applies to. Plain prose; the model reads it as an instruction from the administrators.</source>
        <target>Wird in den System-Prompt jeder Unterhaltung geschrieben, für die sie gilt. Schlichter Text; das Modell liest ihn als Anweisung der Administratoren.</target>
      </trans-unit>
      <trans-unit id="tx_webconaiassistant_instruction.title" resname="tx_webconaiassistant_instruction.title">
        <source>Title</source>
        <target>Titel</target>
      </trans-unit>
    </body>
  </file>
