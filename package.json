{
  "name": "webconsulting-typo3-shadcn-ui",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "The shadcn/ui runtime for TYPO3 backend modules and the AI chat built on it",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "vite build --config Build/Frontend/vite.config.ts && vite build --config Build/Frontend/vite.demo.config.ts",
    "dev": "vite build --watch --mode development --config Build/Frontend/vite.config.ts",
    "test": "vitest run --config Build/Frontend/vitest.config.ts",
    "test:watch": "vitest --config Build/Frontend/vitest.config.ts",
    "lint": "tsc --noEmit -p Build/Frontend/tsconfig.json && eslint --config Build/Frontend/eslint.config.js Build/Frontend/src Build/Frontend/demo Build/Frontend/tests Resources/Public/JavaScript/launcher.js"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.45.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
