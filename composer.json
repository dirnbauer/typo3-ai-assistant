{
    "name": "webconsulting/typo3-shadcn-ui",
    "description": "shadcn/ui runtime for TYPO3 backend modules (React 19, Tailwind v4, Shadow DOM) with the AI chat that talks to your installation through in-process MCP tools",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "extension",
        "shadcn",
        "react",
        "backend",
        "AI",
        "chat",
        "MCP",
        "LLM"
    ],
    "authors": [
        {
            "name": "Webconsulting",
            "homepage": "https://github.com/dirnbauer",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-shadcn-ui",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-shadcn-ui/issues",
        "source": "https://github.com/dirnbauer/typo3-shadcn-ui"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-mcp-server.git",
            "only": [
                "hn/typo3-mcp-server"
            ]
        },
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-abilities.git",
            "only": [
                "webconsulting/typo3-abilities"
            ]
        }
    ],
    "require": {
        "php": "^8.4",
        "hn/typo3-mcp-server": "^0.7",
        "netresearch/nr-llm": "^0.35",
        "phpoffice/phpword": "^1.0",
        "smalot/pdfparser": "^2.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpoffice/phpspreadsheet": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.4 || ^13.0",
        "saschaegerer/phpstan-typo3": "^3.0",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.5"
    },
    "suggest": {
        "phpoffice/phpspreadsheet": "Lets editors attach XLSX spreadsheets to a chat message"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\ShadcnUi\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\ShadcnUi\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "platform": {
            "php": "8.4.0"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "shadcn_ui",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "ci": [
            "@ci:phpstan",
            "@ci:cgl",
            "@ci:tests"
        ],
        "ci:phpstan": ".Build/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
        "ci:cgl": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "ci:tests": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/UnitTests.xml && php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "ci:tests:unit": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "ci:tests:functional": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "fix:cgl": ".Build/bin/php-cs-fixer fix"
    }
}
